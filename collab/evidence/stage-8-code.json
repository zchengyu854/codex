        "preview": "diff --git a/report.py b/report.py\nnew file mode 100644\nindex 0000000..3cf7c84\n--- /dev/null\n+++ b/report.py\n@@ -0,0 +1,18 @@\n+import argparse\n+from slug import slug\n+from total import total\n+\n+\n+def render(title, values):\n+    return f\"{slug(title)}:{total(values)}\"\n+\n+\n+if __name__ == \"__main__\":\n+    parser = argparse.ArgumentParser()\n+    parser.add_argument(\"title\")\n+    parser.add_argument(\"values\", nargs=\"*\")\n+    args = parser.parse_args()\n+    try:\n+        print(render(args.title, args.values))\n+    except ValueError:\n+        parser.error(\"values must be integers\")\ndiff --git a/tests/test_report.py b/tests/test_report.py\nnew file mode 100644\nindex 0000000..3c39068\n--- /dev/null\n+++ b/tests/test_report.py\n@@ -0,0 +1,24 @@\n+import subprocess\n+import sys\n+import unittest\n+from report import render\n+\n+\n+class ReportTests(unittest.TestCase):\n+    def test_both_features(self):\n+        self.assertEqual(render(\" Hello\\t World \", [\"2\", \"-1\", \"4\"]), \"hello-world:5\")\n+\n[truncated]"
